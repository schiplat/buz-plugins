# Generated (regenerable via CI / build scripts)
dist/

# reviews.json IS committed: it is the trust artifact consumers resolve
# against (Manager reviewed_manifest, site badges). Official (buz/*)
# entries are regenerated by CI on green master; community entries are
# appended via scripts/gen_reviews.py after human review.
!reviews.json

# plugins/index.json and plugins/buz/<id>/meta.json ARE committed: the
# full-meta manifests (id/version/sha256 plus the scalar meta incl.
# requires_buz) are the compatibility contract — git clones and offline
# consumers get them without the deployed site. CI regenerates byte-identical
# copies for deploys and release assets.

# Signing keys NEVER live in the repo (the signature proves the index was not
# rewritten; a committed key would prove nothing). Generate with
# `buz-plugin keygen --out signing-key.json` and keep it in a CI secret.
signing-key*.json
*-signing-key.json
*.ed25519

# Node
node_modules/
frontend/dist/

# Misc
.DS_Store
