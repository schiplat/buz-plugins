# Generated (regenerable via CI / build scripts)
dist/

# reviews.json IS committed: it is the trust artifact consumers resolve
# against (Manager reviewed_manifest, site badges). Official (buz/*)
# entries are regenerated by CI on green master; community entries are
# appended via scripts/gen_reviews.py after human review.
!reviews.json

# index.json is committed too: the full-meta manifest (id/version/sha256
# plus the scalar meta incl. requires_buz) is the compatibility contract —
# git clones and offline consumers get it without the deployed site. CI
# regenerates a byte-identical copy for deploys and release assets.

# Node
node_modules/
frontend/dist/

# Misc
.DS_Store
